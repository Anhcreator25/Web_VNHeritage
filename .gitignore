#===================
# Project cleanup .gitignore (root)
#===================
# Log files generated at runtime
*.log

# Temporary JSON test files (e.g., from manual API tests)
tmp_*.json

# Environment configuration files (keep locally, do not track)
.env
.env.*

# Node modules (often heavy, rebuilt via npm install)
node_modules/

# Data files generated by the crawler (optional – uncomment if you want them ignored)
# articles.json
# site_comment.json
# comment_detail.json
